# Example values. Validate model availability and quota before deployment.
# location        = "swedencentral"
# project_name    = "foundrydemo"
# model_name      = "gpt-5.6-terra"
# model_version   = "2026-07-09"
# model_sku_name  = "GlobalStandard"
# model_capacity  = 10
# github_repository       = "octo-org/foundry-demo"
# github_environment_name = "dev"
# Only required when the repository emits immutable OIDC subject claims.
# Read the exact value from:
#   gh api repos/<owner>/<name>/actions/oidc/customization/sub --jq .sub_claim_prefix
# github_oidc_subject_prefix = "repo:octo-org@1234567/foundry-demo@7654321"
#
# subscription_id and operator_object_ids are supplied by the environment, not
# by this file, so that local runs and GitHub Actions produce identical plans:
#   export TF_VAR_subscription_id="00000000-0000-0000-0000-000000000000"
#   export TF_VAR_operator_object_ids='["00000000-0000-0000-0000-000000000000"]'
#
# Object IDs of the per-agent identities Foundry creates for hosted agents.
# They do not exist until an agent has been deployed once; leave the map empty
# on a first apply and fill it in afterwards.
#   az ad sp list --filter "displayName eq '<account>-<project>-<agent>-AgentIdentity'" --query "[0].id" -o tsv
# hosted_agent_object_ids = {
#   "architecture-advisor" = "00000000-0000-0000-0000-000000000000"
# }
#
# Token Control model gateway for the admin-connected Foundry model used by
# release-notes-writer. Omit the block to leave the connection uncreated; the
# release-notes-writer deployment then fails with a configuration error.
#
# Defaults suit a gateway serving the OpenAI v1 shape
# ({base_url}/chat/completions, model in the body). For an Azure-OpenAI-shaped
# gateway ({base_url}/deployments/{name}/chat/completions) set
# deployment_in_path = true and supply an inference_api_version.
# token_control = {
#   base_url        = "https://<host>/api/v1/openai"
#   deployment_name = "gpt-5.2"
#   model_name      = "gpt-5.2"
#   model_version   = "2025-12-11"
#   # deployment_in_path    = false
#   # inference_api_version = ""
# }
#
# The API key is a secret and never belongs in a tfvars file:
#   export TF_VAR_token_control_api_key="..."
